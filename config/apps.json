    "launch": {
      "args": "--no-sandbox --disable-gpu --disable-dev-shm-usage --disable-gpu-sandbox",
      "extractAndRun": true,
      "preLaunchCommand": "mkdir -p /data/home/.config/VSCodium/User && test -f /data/home/.config/VSCodium/User/settings.json || echo '{\"files.simpleDialog.enable\":true,\"window.titleBarStyle\":\"custom\",\"telemetry.telemetryLevel\":\"off\"}' > /data/home/.config/VSCodium/User/settings.json",
      "workingDirectory": "/data/home",
      "healthcheckPath": "/"
    },
    "resources": {
      "cpuCores": 2,
      "memoryMb": 4096
    },
    "display": {
      "width": 1440,
      "height": 900,
      "depth": 24
    },
    "storage": {
      "mode": "per-client"
    },
    "session": {
      "resume": true
    },
    "env": {
      "ELECTRON_DISABLE_SANDBOX": "1",
      "ELECTRON_DISABLE_GPU": "1",
      "APP_UI_MODE": "kiosk"
    }
